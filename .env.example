# Haxatax Environment Configuration (EU Sovereign Hosting Default)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL — Neon (EU Region eu-west-3, Paris)
# Replace <user>, <password>, <endpoint-id> with your Neon project credentials.
# Find them at: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://<user>:<password>@ep-<endpoint-id>.eu-west-3.aws.neon.tech/haxatax?sslmode=require

# For local development without Neon:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haxatax

# Optional seed overrides (defaults: admin@haxatax.fr / Haxatax2026!)
# SEED_ADMIN_EMAIL=admin@yourfirm.fr
# SEED_ADMIN_PASSWORD=YourStrongPassword123!

# Private EU Object Storage (10-Year Statutory Retention - Art. L123-22 Code de commerce)
STORAGE_REGION=eu-west-3
STORAGE_BUCKET=haxatax-archives-eu
