{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
